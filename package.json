{
  "name": "sudoku",
  "version": "2.0.0",
  "description": "Pure JavaScript sudoku solver and difficulty grader with solving algorithm visualisation using latest ES6 language features",
  "main": "script.js",
  "scripts": {
    "build": "esbuild script.js --bundle --target=es2019 --minify --outfile=main.js",
    "watch": "esbuild script.js --bundle --target=es2019 --sourcemap=inline --outfile=main.js --watch",
    "test": "node --test test/",
    "lint": "eslint script.js src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bristoljon/sudoku.git"
  },
  "author": "Jon Wyatt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bristoljon/sudoku/issues"
  },
  "homepage": "https://github.com/bristoljon/sudoku#readme",
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^2.8.0",
    "eslint-config-airbnb": "^7.0.0",
    "gulp": "^3.8.11",
    "gulp-util": "^3.0.4",
    "vinyl-ftp": "^0.4.5"
  }
}
