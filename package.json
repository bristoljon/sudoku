{
  "name": "sudoku",
  "version": "1.0.0",
  "description": "Sudoku solver with algorithm visualisation, installable as a PWA, with camera scan-to-import",
  "main": "script.js",
  "scripts": {
    "build": "esbuild script.js --bundle --minify --target=es2018 --outfile=main.js",
    "watch": "esbuild script.js --bundle --target=es2018 --outfile=main.js --sourcemap --watch",
    "serve": "npx http-server -c-1 .",
    "deploy": "npm run build && node deploy.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bristoljon/sudoku.git"
  },
  "author": "Jon Wyatt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bristoljon/sudoku/issues"
  },
  "homepage": "https://github.com/bristoljon/sudoku#readme",
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.27.0",
    "basic-ftp": "^5.0.5"
  },
  "type": "module"
}
